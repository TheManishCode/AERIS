[Desktop Entry]
Type=Service
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
# all/all so the action is offered for any selection, files and folders alike —
# a collection is deliberately indifferent to what is in it.
MimeType=all/all;
Actions=palisadeCollect;

[Desktop Action palisadeCollect]
TryExec=PALISADE_BIN
Exec=PALISADE_BIN collect %F
Icon=bookmark-new
Name=Group in Palisade
