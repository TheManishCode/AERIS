#!/usr/bin/env bash
# AERIS launcher.
#
# gtk4-layer-shell has to be loaded before libwayland-client, which a language
# binding cannot arrange on its own — hence LD_PRELOAD. This is the documented
# way to use the library from Python.
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

# Debian and Ubuntu put libraries in /usr/lib/<gnu-triplet>. Without that in
# the list, a correct apt install of gtk4-layer-shell is invisible here and
# the daemon refuses to start on the distributions where the package exists.
triplet=""
command -v gcc >/dev/null 2>&1 && triplet="$(gcc -print-multiarch 2>/dev/null || true)"
[ -n "$triplet" ] || triplet="$(uname -m)-linux-gnu"

# Prefer a system install; fall back to the user prefix we build into.
for prefix in /usr "$HOME/.local"; do
    for libdir in "$prefix/lib" "$prefix/lib/$triplet" "$prefix/lib64"; do
        if [ -e "$libdir/libgtk4-layer-shell.so.0" ]; then
            LAYER_SHELL_LIB="$libdir/libgtk4-layer-shell.so.0"
            LAYER_SHELL_LIBDIR="$libdir"
            break 2
        fi
    done
done

if [ -z "${LAYER_SHELL_LIB:-}" ]; then
    echo "aeris: libgtk4-layer-shell.so.0 not found." >&2
    echo "  Arch:   sudo pacman -S gtk4-layer-shell" >&2
    echo "  Source: see docs/INSTALL.md" >&2
    exit 1
fi

export LD_PRELOAD="${LAYER_SHELL_LIB}${LD_PRELOAD:+:$LD_PRELOAD}"
export GI_TYPELIB_PATH="${LAYER_SHELL_LIBDIR}/girepository-1.0${GI_TYPELIB_PATH:+:$GI_TYPELIB_PATH}"
export LD_LIBRARY_PATH="${LAYER_SHELL_LIBDIR}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# Core's own source, plus any sibling modules when this is run out of the
# monorepo. After `git subtree split` the siblings do not exist, the glob
# matches nothing, and installed modules are found through their entry points
# in site-packages instead — so one line serves both layouts.
dev_path="$here/src"
dev_modules=""
for sibling in "$here"/../aeris-*/src/aeris_*; do
    [ -d "$sibling" ] || continue
    dev_path="$dev_path:$(dirname "$sibling")"
    # A checkout has no .dist-info, so entry points would find nothing.
    # AERIS_MODULES names them explicitly; see aeris/registry.py.
    dev_modules="${dev_modules:+$dev_modules,}$(basename "$sibling"):MODULE"
done
export PYTHONPATH="$dev_path${PYTHONPATH:+:$PYTHONPATH}"
[ -n "$dev_modules" ] && export AERIS_MODULES="${AERIS_MODULES:-$dev_modules}"

# Sourcing hook, for `tools/screenshots.sh` and nothing else. Setting up this
# environment correctly is fiddly enough that a second copy of it in a dev
# tool would be wrong within a release; sourcing means there is one.
# Deliberately not documented as a feature: it is not one.
[ "${AERIS_LAUNCHER_SOURCE_ONLY:-}" = "1" ] && return 0

exec python3 -m aeris "$@"
