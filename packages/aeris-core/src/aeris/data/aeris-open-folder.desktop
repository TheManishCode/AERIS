[Desktop Entry]
Type=Service
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
# Separate from the collect menu because a service menu applies one MimeType to
# every action it declares, and "open this as a tab" only means anything for a
# folder.
MimeType=inode/directory;
Actions=aerisOpenFolder;

[Desktop Action aerisOpenFolder]
TryExec=AERIS_BIN
Exec=AERIS_BIN new %f
Icon=folder-open
Name=Open as an AERIS tab
